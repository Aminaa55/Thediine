# Copy to .env and fill in. NEVER commit .env — it holds real credentials.
# .env is already in .gitignore. Nothing in this file should ever hold a real
# secret; it is a list of names, not values.

# PostgreSQL connection string (Neon or Supabase).
DATABASE_URL="postgresql://user:password@host/thediine?sslmode=require"

# Where new-order alerts and customer confirmations go.
NEXT_PUBLIC_WHATSAPP_NUMBER="+201123030107"

# Public site URL. Paymob's return and webhook URLs are built from this, so it
# must be the real, public address of the site once it is deployed.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ----------------------------------------------------------------- Admin
# Signs the admin session cookie. Any long random string of at least 24
# characters; generate one with:  openssl rand -base64 32
# Without it nobody can sign in to /admin. The customer site is unaffected.
ADMIN_SESSION_SECRET=""

# ---------------------------------------------------------------- Paymob
# Card payments go through Paymob's HOSTED checkout. No card details ever reach
# this site, and none of the values below may ever be committed or sent to a
# browser. Card stays hidden from customers until these are set AND the
# payment_card_enabled setting is "true".

# Card payments are PAUSED in the code (CARD_PAYMENTS_PAUSED in
# src/lib/paymob.ts). Nothing below is needed while that is true, and card is
# not shown to customers at all. When card comes back, set that to false and
# fill these in.

# "test" or "live". Anything other than "live" means test. Leave it as test.
PAYMOB_MODE="test"

# Paymob -> Settings -> API Keys. SERVER ONLY, both of them.
PAYMOB_SECRET_KEY=""     # "egy_sk_test_..."  — authorises payment requests
PAYMOB_HMAC_SECRET=""    # the HMAC           — verifies Paymob's callbacks

# Also from Settings -> API Keys. Public by design: it only names the merchant
# on Paymob's own checkout page. Kept here so it is set in one place.
PAYMOB_PUBLIC_KEY=""     # "egy_pk_test_..."

# Optional. Paymob -> Developers -> Payment Integrations -> the Online Card
# integration's ID. Only needed if your account requires the integration id
# rather than the method name.
PAYMOB_CARD_INTEGRATION_ID=""

# Optional. Defaults to Egypt. Only change for another Paymob region.
PAYMOB_BASE_URL="https://accept.paymob.com"

# NOT USED: the legacy "API key" from the same screen belongs to Paymob's older
# three-step flow. This integration uses the Intention API, which authenticates
# with the secret key. Do not add it.
