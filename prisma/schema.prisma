// The Diine — data model
//
// Conventions:
//  * All money is stored as INTEGER PIASTRES (1 EGP = 100). 1,250 EGP -> 125000.
//    This removes floating-point rounding errors from order totals.
//  * Every customer-facing name/description has an `...En` and a nullable `...Ar`
//    field so Arabic can be switched on later without a schema change.
//  * Orders SNAPSHOT names and prices at the time of ordering, so editing the
//    menu never rewrites order history.
//  * Fields the business has not yet confirmed are nullable and never guessed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- catalogue

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  nameEn        String
  nameAr        String?
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  products      Product[]

  @@index([sortOrder])
}

model Product {
  id            String  @id @default(cuid())
  slug          String  @unique
  nameEn        String
  nameAr        String?
  descriptionEn String?
  descriptionAr String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  /// Price in piastres. NULL when the product sells through variants instead.
  /// This is the NORMAL ORDER price and is never changed by event pricing.
  basePrice Int?

  /// Event pricing, per dish.
  ///
  /// Event portions are cooked for the whole guest list, so an event price is
  /// the normal price scaled by the guest count. On by default, following the
  /// shared ladder in EventPriceTier; switch it off for a dish that should cost
  /// the same at an event as it does in a normal order.
  eventPricingEnabled Boolean @default(true)
  /// Why this dish scales the way it does. Admin-only.
  eventPricingNote    String?

  /// What one unit is: "tray (serves 8)", "1 kg", "12 pieces".
  /// Deliberately empty until the business confirms it — never invented.
  sellingUnitEn String?
  sellingUnitAr String?
  /// Surfaced in admin as a "needs confirming" badge while the unit is unknown.
  unitConfirmed Boolean @default(false)
  /// Not every dish is sold by a unit worth stating, so a missing one is only
  /// a gap where the business says it is. Off by default: nothing is chased,
  /// and no unit is ever invented to clear a warning.
  unitRequired  Boolean @default(false)

  /// Optional; used for desserts, not required for savoury dishes.
  servesMin Int?
  servesMax Int?

  minQuantity  Int @default(1)
  quantityStep Int @default(1)

  /// Overrides the global notice period for dishes needing longer.
  leadTimeDaysOverride Int?

  imageUrl    String?
  isAvailable Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  sortOrder   Int       @default(0)
  /// Archived rather than deleted, so past orders still read correctly.
  archivedAt  DateTime?

  /// Free-text note for anything still unresolved about this product.
  reviewNote String?

  variants     ProductVariant[]
  optionGroups OptionGroup[]
  /// An exception to the shared ladder. Empty means the shared ladder applies.
  eventTiers   ProductEventTier[]
  allergens    ProductAllergen[]
  orderItems   OrderItem[]
  recipeItems  RecipeItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, sortOrder])
  @@index([archivedAt])
}

/// A priced variant, e.g. Noodles > with Chicken. Absolute price, not a delta,
/// so admin types the real number.
/// The shared guest-count ladder for event food pricing.
///
/// One row per guest band. Editable from admin, so the business can reprice
/// every dish at once without a deploy, and without the multipliers being
/// copied into each product row.
///
/// The seeded ladder is the one supplied by the business:
/// up to 10 guests 1x, then +0.5x for every further ten, to 5.5x at 91-100.
model EventPriceTier {
  id String @id @default(cuid())

  minGuests Int
  /// Inclusive.
  maxGuests Int

  /// Multiplier on the normal price, x10000: 10000 = 1x, 15000 = 1.5x.
  /// Integer on purpose — no price in this system is ever held as a float.
  multiplierBp Int

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([minGuests, maxGuests])
  @@index([minGuests])
}

/// A dish that does not follow the shared ladder.
///
/// Ingredient cost and serving size do not scale the same way for every dish,
/// so any product may carry its own bands. A product's rows REPLACE the shared
/// ladder for that product rather than merging with it: a partial ladder would
/// leave guest counts silently unpriced.
model ProductEventTier {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  minGuests Int
  /// Inclusive.
  maxGuests Int

  /// Either a multiplier on the normal price (x10000) OR a flat price in
  /// piastres for this band. Set one; a fixed price wins if both are present.
  multiplierBp Int?
  fixedPrice   Int?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, minGuests, maxGuests])
  @@index([productId, minGuests])
}

model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  nameEn      String
  nameAr      String?
  price       Int
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  orderItems OrderItem[]

  @@index([productId, sortOrder])
}

enum OptionGroupType {
  SINGLE
  MULTI
}

/// A required or optional choice, e.g. "Served with" or "Sauce".
model OptionGroup {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  nameEn     String
  nameAr     String?
  type       OptionGroupType @default(SINGLE)
  isRequired Boolean         @default(true)
  minSelect  Int             @default(1)
  maxSelect  Int             @default(1)
  sortOrder  Int             @default(0)

  choices OptionChoice[]

  @@index([productId, sortOrder])
}

model OptionChoice {
  id      String      @id @default(cuid())
  groupId String
  group   OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  nameEn      String
  nameAr      String?
  /// Piastres added to the line. Main-course accompaniments are all 0 —
  /// the field exists so a charge can be added later without a migration.
  priceDelta  Int     @default(0)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  @@index([groupId, sortOrder])
}

/// Editable from admin; not a fixed enum, so new allergens can be added.
model Allergen {
  id       String  @id @default(cuid())
  slug     String  @unique
  nameEn   String
  nameAr   String?
  isActive Boolean @default(true)

  products ProductAllergen[]
}

model ProductAllergen {
  productId  String
  allergenId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id], onDelete: Cascade)

  /// Pre-tagged from the menu text; must be checked by the business before launch.
  reviewed Boolean @default(false)

  @@id([productId, allergenId])
}

// ------------------------------------------------------------------- people

model Customer {
  id     String  @id @default(cuid())
  name   String
  mobile String  @unique
  email  String?

  orders    Order[]
  addresses Address[]

  createdAt DateTime @default(now())
}

model Address {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  areaId String?
  area   DeliveryArea? @relation(fields: [areaId], references: [id])

  line1   String
  details String?
  notes   String?

  @@index([customerId])
}

enum AdminRole {
  OWNER
  STAFF
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(OWNER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  statusEvents    OrderStatusEvent[]
  cancelledOrders Order[]            @relation("CancelledBy")
}

// --------------------------------------------------------------- operations

model DeliveryArea {
  id        String  @id @default(cuid())
  nameEn    String
  nameAr    String?
  /// Piastres.
  fee       Int
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  addresses Address[]
}

model TimeSlot {
  id        String  @id @default(cuid())
  labelEn   String
  labelAr   String?
  /// "HH:mm" in Africa/Cairo.
  startTime String
  endTime   String
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  orders Order[]
}

/// Per-date overrides: closures, a different cap, or a day blocked by an event.
model DateAvailability {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  isClosed  Boolean  @default(false)
  /// NULL falls back to the global daily capacity setting.
  maxOrders Int?
  note      String?

  /// Set when a confirmed event chose "Block Day".
  blockedByOrderId String? @unique
  blockedByOrder   Order?  @relation("BlocksDate", fields: [blockedByOrderId], references: [id], onDelete: SetNull)
}

/// Business rules the owner can change without a developer:
/// cutoff time, notice periods, daily capacity, cancellation windows and
/// percentage, serving-setup policy text, enabled payment methods.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------- orders

enum OrderType {
  NORMAL
  EVENT
}

enum OrderStatus {
  REQUESTED // events only, before the business accepts
  NEW
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY // skipped for pickup
  DELIVERED
  CANCELLED
}

enum FulfilmentType {
  DELIVERY
  PICKUP
}

enum ServingSetup {
  RETURNABLE
  DISPOSABLE
  /// A serving option the business added itself. The order also stores its
  /// name, so it still reads correctly if the option is renamed or retired.
  OTHER
}

enum PaymentMethod {
  CASH
  INSTAPAY
  CARD // structured, disabled until a gateway is integrated
  /// A payment method the business added itself, settled by hand. The order
  /// stores its name too, for the same reason.
  OTHER
}

/// How customers may pay, as the business defines it.
///
/// The three built-in methods are rows here as well, so one screen lists
/// everything; `builtIn` marks them, because their behaviour is in code and
/// they cannot be deleted. Anything the business adds is MANUAL: money that
/// arrives outside this system and is confirmed by a person. INTEGRATED means
/// a provider has to be built and connected before it can ever be offered.
model PaymentOption {
  id      String  @id @default(cuid())
  /// "CASH", "INSTAPAY", "CARD" for the built-ins; null for anything added.
  builtIn String? @unique

  nameEn String
  /// Shown to the customer when they choose it: where to send the money.
  instructionsEn String?

  kind      PaymentOptionKind @default(MANUAL)
  isEnabled Boolean           @default(false)
  /// Whether the money is expected before delivery, which is what decides
  /// where the payment starts: awaiting verification, or simply unpaid.
  verifyBeforeDelivery Boolean @default(false)
  /// Set for an integrated method once a provider is actually wired up.
  providerKey String?

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PaymentOptionKind {
  MANUAL
  INTEGRATED
}

/// How the food is served. Returnable and disposable are built in; the
/// business can add more without a developer.
model ServingOption {
  id      String  @id @default(cuid())
  /// "RETURNABLE" or "DISPOSABLE" for the built-ins; null for anything added.
  builtIn String? @unique

  nameEn        String
  descriptionEn String?
  isAvailable   Boolean @default(true)

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Deliberately independent of OrderStatus: a delivered order can be unpaid.
enum PaymentStatus {
  UNPAID
  AWAITING_VERIFICATION // InstaPay transfer claimed, not yet checked
  PAID
  REFUNDED
}

model Order {
  id          String      @id @default(cuid())
  /// Human-readable, shown to the customer and used over WhatsApp.
  orderNumber String      @unique
  /// Unguessable id for the confirmation page, so an order can be linked to
  /// without exposing anyone else's by counting up from an order number.
  publicToken String      @unique @default(cuid())
  type        OrderType   @default(NORMAL)
  status      OrderStatus @default(NEW)

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Snapshots — the order stays readable even if the customer record changes.
  customerName   String
  customerMobile String
  customerEmail  String?

  fulfilmentType FulfilmentType
  deliveryDate   DateTime       @db.Date
  timeSlotId     String?
  timeSlot       TimeSlot?      @relation(fields: [timeSlotId], references: [id])
  timeSlotLabel  String?

  areaId         String?
  areaName       String?
  addressLine    String?
  addressDetails String?

  servingSetup ServingSetup
  /// The name of the serving option as it was when the order was placed.
  /// Snapshotted so renaming or retiring an option never rewrites an order.
  servingSetupLabel String?

  // All piastres.
  subtotal    Int
  /// NULL means the fee is not known yet — the delivery areas and their fees
  /// have not been supplied, so it is confirmed when the order is. It is not
  /// zero, and `total` excludes it while it is unknown.
  deliveryFee Int?
  discount    Int  @default(0)
  total       Int

  paymentMethod     PaymentMethod
  /// The name of the payment method as it was when the order was placed.
  paymentMethodLabel String?
  paymentStatus     PaymentStatus @default(UNPAID)
  /// The customer's own reference for a transfer they say they have made.
  paymentReference  String?
  paymentVerifiedAt DateTime?

  // --- card payments, through a provider ------------------------------------
  // The site never sees a card number. Only the provider's own references are
  // stored, and only after a signed callback has been verified.
  /// Which provider handled it. "paymob" today; null for cash and InstaPay.
  paymentProvider      String?
  /// "test" or "live" — recorded so a test payment can never be mistaken for real.
  paymentProviderMode  String?
  /// Our reference sent to the provider; comes back as their merchant_order_id.
  paymentMerchantRef   String? @unique
  /// The provider's id for the payment attempt.
  paymentIntentionId   String?
  /// The provider's id for the transaction, once one exists.
  paymentTransactionId String?

  paymentEvents PaymentEvent[]

  notes  String?
  source String  @default("website")

  // Cancellation — recorded in full; the charge is calculated, never collected.
  cancelledAt               DateTime?
  cancelledById             String?
  cancelledBy               AdminUser? @relation("CancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  cancellationReason        String?
  cancelledWithinFreeWindow Boolean?
  cancellationCharge        Int?

  items        OrderItem[]
  statusEvents OrderStatusEvent[]
  eventDetail  EventDetail?
  blocksDate   DateAvailability?  @relation("BlocksDate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([deliveryDate, status])
  @@index([type, status])
  @@index([customerMobile])
  @@index([createdAt])
}

enum EventType {
  BIRTHDAY
  ENGAGEMENT
  WEDDING
  OTHER
}

/// How much of the day a confirmed event consumes. Chosen by admin per event,
/// defaulting to BLOCK_DAY.
enum EventCapacityMode {
  BLOCK_DAY
  KEEP_DAY_OPEN
}

model EventDetail {
  id      String @id @default(cuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  eventType      EventType
  /// Only set when eventType is OTHER; stored alongside, not instead of, the type.
  eventTypeOther String?
  guestCount     Int
  eventTime      String?

  /// The guest band the food was priced at, x10000 (25000 = 2.5x). Recorded so
  /// the order stays readable after the ladder is edited.
  pricingMultiplierBp Int?

  /// All three extras are quote-based: they carry no price and add nothing to
  /// the order total. The business quotes them when confirming the event.
  decorRequested        Boolean @default(false)
  decorNotes            String?
  setupRequested        Boolean @default(false)
  servingStaffRequested Boolean @default(false)
  extrasNotes           String?

  venueName String?

  capacityMode EventCapacityMode @default(BLOCK_DAY)
  confirmedAt  DateTime?
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshots.
  productName String
  variantName String?
  unitPrice   Int
  quantity    Int
  lineTotal   Int

  instructions String?

  options OrderItemOption[]

  @@index([orderId])
}

model OrderItemOption {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  groupName  String
  choiceName String
  priceDelta Int    @default(0)

  @@index([orderItemId])
}

model OrderStatusEvent {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  fromStatus  OrderStatus?
  toStatus    OrderStatus
  changedById String?
  changedBy   AdminUser?   @relation(fields: [changedById], references: [id], onDelete: SetNull)
  note        String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

/// Every callback a payment provider has sent us about an order.
///
/// Written whether or not the signature checked out and whether or not the
/// payment succeeded, so there is always a record of what arrived and what we
/// did about it. It is also what makes a repeated callback harmless: the same
/// transaction cannot be applied twice.
model PaymentEvent {
  id      String  @id @default(cuid())
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  provider      String
  /// "webhook" or "redirect" — the same outcome arrives both ways.
  channel       String
  /// The provider's transaction id.
  transactionId String?
  /// Our reference, as the provider echoed it back.
  merchantRef   String?

  /// Did the signature verify? A false here means nothing was changed.
  signatureValid Boolean
  /// Did we treat it as paid?
  applied        Boolean @default(false)
  /// Amount the provider reported, in piastres.
  amount         Int?
  /// Why it was not applied, when it was not.
  note           String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([transactionId])
}

// ------------------------------------------------- inventory (designed, unbuilt)
// No screens in the MVP. Present so recipe-based stock deduction can be added
// later without altering anything above.

model Ingredient {
  id             String  @id @default(cuid())
  nameEn         String
  nameAr         String?
  unit           String // kg, g, litre, piece
  quantityOnHand Decimal @default(0) @db.Decimal(12, 3)
  minLevel       Decimal @default(0) @db.Decimal(12, 3)
  /// Piastres per unit.
  costPerUnit    Int?
  isActive       Boolean @default(true)

  recipeItems    RecipeItem[]
  stockMovements StockMovement[]
}

model RecipeItem {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  /// Consumed per one unit of the product.
  quantity     Decimal    @db.Decimal(12, 3)

  @@unique([productId, ingredientId])
}

model StockMovement {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  /// Negative for consumption, positive for a purchase.
  change       Decimal    @db.Decimal(12, 3)
  reason       String
  orderId      String?
  createdAt    DateTime   @default(now())

  @@index([ingredientId, createdAt])
}

// ------------------------------------------------------------------ gallery

/// Photographs of real dishes, tables and events, shown in "Our Work".
/// Managed from admin: add, remove, reorder. Never hardcoded in the interface.
model GalleryImage {
  id        String           @id @default(cuid())
  imageUrl  String
  altEn     String
  altAr     String?
  captionEn String?
  captionAr String?
  /// Lets the same library feed different places without duplicating rows.
  placement GalleryPlacement @default(BOTH)
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)

  createdAt DateTime @default(now())

  @@index([placement, sortOrder])
}

enum GalleryPlacement {
  HOME
  EVENTS
  BOTH
}
